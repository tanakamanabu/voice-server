# このファイルを .env にコピーして実際の値を設定してください
# cp .env.example .env

# Flask セッションの署名キー（任意のランダム文字列）
SECRET_KEY=change-me-in-production

# Home Assistant の URL（homeassistant コンテナは network_mode: host のためホストIPで指定）
HA_URL=http://192.168.1.40:8123

# Home Assistant の長期アクセストークン
# 取得方法: HA → プロフィール → セキュリティ → 長期アクセストークン → トークンを作成
HA_TOKEN=

# Home Assistant のエンティティ ID（HA の実際の値に合わせて変更）
HA_LIGHT_ENTITY=light.living_room
HA_AC_ENTITY=climate.living_room
HA_PC_ENTITY=switch.pc
